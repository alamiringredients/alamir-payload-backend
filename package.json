{
  "name": "alamir-payload-backend",
  "version": "1.0.0",
  "description": "Alamir Ingredients backend powered by Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "npm run generate:importmap && npm run generate:types",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node --import dotenv/config node_modules/next/dist/bin/next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "node --import dotenv/config node_modules/next/dist/bin/next start",
    "test": "npm run test:int",
    "test:int": "vitest run --fileParallelism",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "refresh:public": "tsx scripts/refresh-public-content.ts",
    "seed:export": "tsx scripts/export-seed.ts",
    "migrate": "cross-env NODE_ENV=production payload migrate",
    "migrate:status": "cross-env NODE_ENV=production payload migrate:status",
    "jobs:work": "cross-env NODE_ENV=production node --import dotenv/config node_modules/payload/bin.js jobs:run --cron \"*/5 * * * * *\" --queue emails --limit 25",
    "jobs:run": "cross-env NODE_ENV=production node --import dotenv/config node_modules/payload/bin.js jobs:run --queue emails --limit 25",
    "content:sync": "tsx scripts/export-frontend-content.ts",
    "content:check": "tsx scripts/export-frontend-content.ts --check"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "^3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "^16.4.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
